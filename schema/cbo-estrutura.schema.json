{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbq.dev/schema/cbo-estrutura.schema.json",
  "title": "Nível da espinha enumerativa da CBO 2002",
  "type": "object",
  "required": [
    "versao_dados",
    "fonte",
    "nivel",
    "total",
    "itens"
  ],
  "properties": {
    "versao_dados": {
      "type": "string"
    },
    "fonte": {
      "type": "string"
    },
    "nivel": {
      "type": "string",
      "enum": [
        "grandes-grupos",
        "subgrupos-principais",
        "subgrupos",
        "familias"
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "codigo",
          "titulo",
          "fonte"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "pattern": "^[0-9]{1,4}$"
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "pai": {
            "type": "string",
            "pattern": "^[0-9]{1,3}$",
            "description": "prefixo do código, ausente no nível de topo"
          },
          "fonte": {
            "$ref": "#/$defs/fonte"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "fonte": {
      "type": "object",
      "required": [
        "arquivo",
        "linha"
      ],
      "properties": {
        "arquivo": {
          "type": "string"
        },
        "linha": {
          "type": "integer",
          "minimum": 2
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
